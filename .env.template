# Environment Variables Template
# Copy this file to .env and update the values

# Admin Panel Access Key
# Change this to a secure, random string in production
ACCESS_KEY=your_super_secure_access_key_here

# Optional: Database connection (for future enhancements)
# DB_HOST=localhost
# DB_NAME=tracker_db
# DB_USER=tracker_user
# DB_PASS=tracker_password

# Optional: API rate limiting (requests per minute)
# RATE_LIMIT=100

# Optional: Custom redirect URL
# DEFAULT_REDIRECT_URL=https://www.google.com/